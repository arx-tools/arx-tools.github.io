---
import '../styles/global.css'
import '../styles/home.css'
import '../styles/header.css'
import '../styles/footer.css'
import '../styles/info-with-link.css'
import '../styles/mod.css'

interface Props {
  /**
   * the canonical path of the page, starts and ends with a slash (`/`, `/maps/`)
   */
  path: string

  title?: string
  description?: string
}

const brandTitle = 'Arx Fatalis Maps, Mods and Modding Tools'
const { path, title, description } = Astro.props

// GoatCounter: cookieless pageview counting, nothing is stored in the browser and the IP address
// is not stored either (only an aggregate country). `noden-gaming` is the site code of the
// Noden Gaming YouTube channel, and every pageview here is reported under the `/arx` prefix, so
// the channel's own pages and these stay apart in the same dashboard. The `/editor/` page is
// served from `public/editor`, so it carries its own copy of this snippet, added by the editor.
const goatCounterSite = 'noden-gaming'

// must be a `set:html` string and not an `is:inline` script body: Astro's `compressHTML` does not
// touch the content of an inline script, so the source would ship with its whitespace and the
// rest of the page would not. This one-liner is what ends up in the built HTML.
const goatCounterPath = `window.goatcounter={path:function(p){return'/arx'+p}}`

const pageTitle = title ? `${title} - ${brandTitle}` : brandTitle
const pageDescription = description ?? brandTitle
const pageURL = `https://arx-tools.github.io${path}`
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={pageURL} />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageURL} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={brandTitle} />

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css"
      integrity="sha512-2SwdPD6INVrV/lHTZbO2nodKhrnDdJK9/kg2XD1r9uGqPo1cUbujc+IYdlYdEErWNu69gVcYgdxlmVmzTWnetw=="
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />

    {
      /* only on the published site: the dev server and localhost are not counted anyway */
      import.meta.env.PROD && (
        <>
          <script is:inline set:html={goatCounterPath} />
          <script
            is:inline
            async
            data-goatcounter={`https://${goatCounterSite}.goatcounter.com/count`}
            src="https://gc.zgo.at/count.js"
          />
        </>
      )
    }
  </head>
  <body>
    <slot />
  </body>
</html>
